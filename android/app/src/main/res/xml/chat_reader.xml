<?xml version="1.0" encoding="utf-8"?>
<!-- Chat apps (open conversation) and the system Live Caption box (call words during a call). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowStateChanged|typeViewScrolled|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/chat_reader_description"
    android:notificationTimeout="250"
    android:packageNames="com.whatsapp,com.whatsapp.w4b,com.instagram.android,org.telegram.messenger,com.google.android.apps.messaging,com.samsung.android.messaging,com.facebook.orca,com.google.android.as,com.google.android.gm,com.microsoft.office.outlook,com.samsung.android.email.provider" />
